  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Table_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 9fa6c6f57ed4d3642974321781fbb65b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2664474185728
    m_Localized: "Esta es una estatua de un soldado ca\xEDdo....."
    m_Metadata:
      m_Items: []
  - m_Id: 37552670720000
    m_Localized: "Su espada podr\xEDa servirme de algo."
    m_Metadata:
      m_Items: []
  - m_Id: 44303574974464
    m_Localized: "Prometo que la devolver\xE9..."
    m_Metadata:
      m_Items: []
  - m_Id: 197539514630144
    m_Localized: "Espada de un h\xE9roe ca\xEDdo. Te servir\xE1 para defenderte, por ahora. Presiona Z o CLICK para atacar."
    m_Metadata:
      m_Items: []
  - m_Id: 346382071840768
    m_Localized: "Pensamos que los muros nos proteger\xEDan... Pero la sombra no rompe la piedra, se filtra por el miedo."
    m_Metadata:
      m_Items: []
  - m_Id: 346431963086848
    m_Localized: "Cuando nos dimos cuenta, %(ya la llev\xE1bamos dentro)%."
    m_Metadata:
      m_Items: []
  - m_Id: 439557679562752
    m_Localized: "Tu guardia termina aqu\xED. La m\xEDa apenas comienza."
    m_Metadata:
      m_Items: []
  - m_Id: 522667238703104
    m_Localized: Estas parecen ser las escaleras del antiguo pozo...
    m_Metadata:
      m_Items: []
  - m_Id: 527828824702976
    m_Localized: "Obtuviste la Percepci\xF3n Astral, ahora podr\xE1s encontrar nuevos caminos. \xDAsala con E o X."
    m_Metadata:
      m_Items: []
  - m_Id: 530613150498816
    m_Localized: "Estoy segura de que esa sombra entr\xF3 por aqu\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 530702812135424
    m_Localized: "%(Tengo que atraparla)%, solo as\xED podr\xE9 liberar a mi pueblo."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
